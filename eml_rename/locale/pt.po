msgid "You pressed 'Ctrl+C', exiting..."
msgstr "Pressionou 'Ctrl+C', a sair..."

msgid "Developed by Mariano Muñoz 2022-{}"
msgstr "Desenvolvido por Mariano Muñoz 2022-{}"

msgid "Script renames all eml files in a directory using mail metadata "
msgstr "O script renomeia todos os ficheiros eml num diretório usando os metadados do e-mail "

msgid "Optional path(s) to .eml file(s) or directory. Defaults to current directory."
msgstr "Caminho(s) opcional(ais) para ficheiro(s) .eml ou diretório. Predefinição: diretório atual."

msgid "Forces subject update when 'YYYYMMDD HHMM [from]' format is detected"
msgstr "Força a atualização do assunto quando o formato 'YYYYMMDD HHMM [de]' for detetado"

#, python-brace-format
msgid "Maximum length allowed to final name using 'YYYYMMDD HHMM [from]'. Default: {0}"
msgstr "Comprimento máximo permitido para o nome final usando 'YYYYMMDD HHMM [de]'. Predefinição: {0}"

msgid "Without this parameter files won't be renamed. Script only pretend the result"
msgstr "Sem este parâmetro os ficheiros não serão renomeados. O script apenas simula o resultado"

msgid "Use Ollama AI with specified model to summarize email content as subject. Default: None (no AI)"
msgstr "Usar a IA Ollama com o modelo especificado para resumir o conteúdo do e-mail como assunto. Predefinição: None (sem IA)"

#, python-brace-format
msgid "Ollama server URL. Default: {0}"
msgstr "URL do servidor Ollama. Predefinição: {0}"

#, python-brace-format
msgid "File or path not found: {0}"
msgstr "Ficheiro ou caminho não encontrado: {0}"

msgid "Processing eml files"
msgstr "A processar ficheiros eml"

#, python-brace-format
msgid "{0} files were renamed."
msgstr "{0} ficheiros foram renomeados."

#, python-brace-format
msgid "Process was simulated, files weren't renamed. Use --save to rename {0} files."
msgstr "O processo foi simulado, os ficheiros não foram renomeados. Use --save para renomear {0} ficheiros."

msgid "It took {}"
msgstr "Demorou {}"

msgid "(Without subject)"
msgstr "(Sem assunto)"

msgid "Error parsing subject"
msgstr "Erro ao analisar o assunto"

msgid "[Error detected. Won't be renamed]"
msgstr "[Erro detetado. Não será renomeado]"

msgid "[Error detected. Not Renamed]"
msgstr "[Erro detetado. Não renomeado]"

msgid "[Will be renamed]"
msgstr "[Será renomeado]"

msgid "[Renamed]"
msgstr "[Renomeado]"

msgid "[Format detected. Won't de renamed]"
msgstr "[Formato detetado. Não será renomeado]"

msgid "[Format detected. Not renamed]"
msgstr "[Formato detetado. Não renomeado]"

