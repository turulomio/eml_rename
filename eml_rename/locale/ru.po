msgid "You pressed 'Ctrl+C', exiting..."
msgstr "Вы нажали 'Ctrl+C', выход..."

msgid "Developed by Mariano Muñoz 2022-{}"
msgstr "Разработано Mariano Muñoz 2022-{}"

msgid "Script renames all eml files in a directory using mail metadata "
msgstr "Скрипт переименовывает все файлы eml в каталоге с использованием метаданных писем "

msgid "Optional path(s) to .eml file(s) or directory. Defaults to current directory."
msgstr "Необязательный путь к файлу(ам) .eml или каталогу. По умолчанию текущий каталог."

msgid "Forces subject update when 'YYYYMMDD HHMM [from]' format is detected"
msgstr "Принудительно обновлять тему, если обнаружен формат 'YYYYMMDD HHMM [от]'"

#, python-brace-format
msgid "Maximum length allowed to final name using 'YYYYMMDD HHMM [from]'. Default: {0}"
msgstr "Максимально допустимая длина итогового имени с форматом 'YYYYMMDD HHMM [от]'. По умолчанию: {0}"

msgid "Without this parameter files won't be renamed. Script only pretend the result"
msgstr "Без этого параметра файлы не будут переименованы. Скрипт только моделирует результат"

msgid "Use Ollama AI with specified model to summarize email content as subject. Default: None (no AI)"
msgstr "Использовать Ollama AI с указанной моделью для создания краткого содержания письма в качестве темы. По умолчанию: None (без ИИ)"

#, python-brace-format
msgid "Ollama server URL. Default: {0}"
msgstr "URL-адрес сервера Ollama. По умолчанию: {0}"

#, python-brace-format
msgid "File or path not found: {0}"
msgstr "Файл или путь не найден: {0}"

msgid "Processing eml files"
msgstr "Обработка файлов eml"

#, python-brace-format
msgid "{0} files were renamed."
msgstr "{0} файлов переименовано."

#, python-brace-format
msgid "Process was simulated, files weren't renamed. Use --save to rename {0} files."
msgstr "Процесс был смоделирован, файлы не переименованы. Используйте --save для переименования {0} файлов."

msgid "It took {}"
msgstr "Заняло {}"

msgid "(Without subject)"
msgstr "(Без темы)"

msgid "Error parsing subject"
msgstr "Ошибка при разборе темы"

msgid "[Error detected. Won't be renamed]"
msgstr "[Обнаружена ошибка. Не будет переименован]"

msgid "[Error detected. Not Renamed]"
msgstr "[Обнаружена ошибка. Не переименован]"

msgid "[Will be renamed]"
msgstr "[Будет переименован]"

msgid "[Renamed]"
msgstr "[Переименован]"

msgid "[Format detected. Won't de renamed]"
msgstr "[Формат обнаружен. Не будет переименован]"

msgid "[Format detected. Not renamed]"
msgstr "[Формат обнаружен. Не переименован]"

