msgid "You pressed 'Ctrl+C', exiting..."
msgstr "Vous avez appuyé sur 'Ctrl+C', sortie en cours..."

msgid "Developed by Mariano Muñoz 2022-{}"
msgstr "Développé par Mariano Muñoz 2022-{}"

msgid "GOOGLE_API_KEY not found. Set it in environment or in ~/.config/eml-rename/config.ini"
msgstr "GOOGLE_API_KEY introuvable. Définissez-la dans l'environnement ou dans ~/.config/eml-rename/config.ini"

msgid "The 'google-genai' package is not installed. Please run 'pip install google-genai' or 'poetry install'."
msgstr "Le paquet 'google-genai' n'est pas installé. Veuillez exécuter 'pip install google-genai' ou 'poetry install'."

msgid "Script renames all eml files in a directory using mail metadata "
msgstr "Ce script renomme tous les fichiers eml d'un répertoire à partir des métadonnées du courriel "

msgid "Optional path(s) to .eml file(s) or directory. Defaults to current directory."
msgstr "Chemin(s) optionnel(s) vers un ou des fichiers .eml ou un répertoire. Par défaut le répertoire courant."

msgid "Forces subject update when 'YYYYMMDD HHMM [from]' format is detected"
msgstr "Force la mise à jour de l'objet lorsque le format 'YYYYMMDD HHMM [de]' est détecté"

#, python-brace-format
msgid "Maximum length allowed to final name using 'YYYYMMDD HHMM [from]'. Default: {0}"
msgstr "Longueur maximale autorisée pour le nom final utilisant 'YYYYMMDD HHMM [de]'. Par défaut : {0}"

msgid "Without this parameter files won't be renamed. Script only pretend the result"
msgstr "Sans ce paramètre, les fichiers ne seront pas renommés. Le script simule uniquement le résultat"

msgid "Use Gemini AI to summarize email content as subject"
msgstr "Utiliser l'IA Gemini pour résumer le contenu du courriel comme objet"

msgid "Delay between AI requests"
msgstr "Délai entre les requêtes à l'IA"

msgid "List available Gemini AI models for content generation and exit"
msgstr "Lister les modèles d'IA Gemini disponibles pour la génération de contenu et quitter"

msgid "Specify Gemini AI model to use and save it to configfile"
msgstr "Spécifier le modèle d'IA Gemini à utiliser et l'enregistrer dans le fichier de configuration"

msgid "Available Gemini AI models:"
msgstr "Modèles d'IA Gemini disponibles :"

msgid "(configured)"
msgstr "(configuré)"

msgid "Error retrieving models"
msgstr "Erreur lors de la récupération des modèles"

#, python-brace-format
msgid "AI model set to '{0}' and saved to configuration."
msgstr "Modèle d'IA défini sur '{0}' et enregistré dans la configuration."

#, python-brace-format
msgid "Warning: Configured model '{0}' is not available in the API. Defaulting to '{1}'."
msgstr "Avertissement : Le modèle configuré '{0}' n'est pas disponible dans l'API. Utilisation par défaut de '{1}'."

#, python-brace-format
msgid "File or path not found: {0}"
msgstr "Fichier ou chemin introuvable : {0}"

msgid "Processing eml files"
msgstr "Traitement des fichiers eml"

#, python-brace-format
msgid "{0} files were renamed."
msgstr "{0} fichiers ont été renommés."

#, python-brace-format
msgid "Process was simulated, files weren't renamed. Use --save to rename {0} files."
msgstr "Le processus a été simulé, les fichiers n'ont pas été renommés. Utilisez --save pour renommer {0} fichiers."

msgid "It took {}"
msgstr "Durée : {}"

msgid "(Without subject)"
msgstr "(Sans objet)"

msgid "Error parsing subject"
msgstr "Erreur lors de l'analyse de l'objet"

msgid "[Error detected. Won't be renamed]"
msgstr "[Erreur détectée. Ne sera pas renommé]"

msgid "[Error detected. Not Renamed]"
msgstr "[Erreur détectée. Non renommé]"

msgid "[Will be renamed]"
msgstr "[Sera renommé]"

msgid "[Renamed]"
msgstr "[Renommé]"

msgid "[Format detected. Won't de renamed]"
msgstr "[Format détecté. Ne sera pas renommé]"

msgid "[Format detected. Not renamed]"
msgstr "[Format détecté. Non renommé]"
