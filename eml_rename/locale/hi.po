msgid "You pressed 'Ctrl+C', exiting..."
msgstr "आपने 'Ctrl+C' दबाया, बाहर निकल रहे हैं..."

msgid "Developed by Mariano Muñoz 2022-{}"
msgstr "Mariano Muñoz द्वारा विकसित 2022-{}"

msgid "GOOGLE_API_KEY not found. Set it in environment or in ~/.config/eml-rename/config.ini"
msgstr "GOOGLE_API_KEY नहीं मिला। इसे पर्यावरण चर में या ~/.config/eml-rename/config.ini में सेट करें"

msgid "The 'google-genai' package is not installed. Please run 'pip install google-genai' or 'poetry install'."
msgstr "'google-genai' पैकेज स्थापित नहीं है। कृपया 'pip install google-genai' या 'poetry install' चलाएँ।"

msgid "Script renames all eml files in a directory using mail metadata "
msgstr "स्क्रिप्ट मेल मेटाडेटा का उपयोग करके निर्देशिका में सभी eml फ़ाइलों का नाम बदलती है "

msgid "Optional path(s) to .eml file(s) or directory. Defaults to current directory."
msgstr ".eml फ़ाइल(फ़ाइलों) या निर्देशिका का वैकल्पिक पथ। डिफ़ॉल्ट वर्तमान निर्देशिका है।"

msgid "Forces subject update when 'YYYYMMDD HHMM [from]' format is detected"
msgstr "'YYYYMMDD HHMM [from]' प्रारूप पाए जाने पर विषय अपडेट को बाध्य करता है"

#, python-brace-format
msgid "Maximum length allowed to final name using 'YYYYMMDD HHMM [from]'. Default: {0}"
msgstr "'YYYYMMDD HHMM [from]' का उपयोग करके अंतिम नाम के लिए अधिकतम अनुमत लंबाई। डिफ़ॉल्ट: {0}"

msgid "Without this parameter files won't be renamed. Script only pretend the result"
msgstr "इस पैरामीटर के बिना फ़ाइलों का नाम नहीं बदला जाएगा। स्क्रिप्ट केवल परिणाम का अनुकरण करती है"

msgid "Use Gemini AI to summarize email content as subject"
msgstr "ईमेल सामग्री को विषय के रूप में संक्षेप करने के लिए Gemini AI का उपयोग करें"

msgid "Delay between AI requests"
msgstr "AI अनुरोधों के बीच विलंब"

msgid "List available Gemini AI models for content generation and exit"
msgstr "सामग्री निर्माण के लिए उपलब्ध Gemini AI मॉडल सूचीबद्ध करें और बाहर निकलें"

msgid "Specify Gemini AI model to use and save it to configfile"
msgstr "उपयोग करने के लिए Gemini AI मॉडल निर्दिष्ट करें और इसे कॉन्फ़िग फ़ाइल में सहेजें"

msgid "Available Gemini AI models:"
msgstr "उपलब्ध Gemini AI मॉडल:"

msgid "(configured)"
msgstr "(कॉन्फ़िगर किया गया)"

msgid "Error retrieving models"
msgstr "मॉडल प्राप्त करने में त्रुटि"

#, python-brace-format
msgid "AI model set to '{0}' and saved to configuration."
msgstr "AI मॉडल '{0}' पर सेट किया गया और कॉन्फ़िगरेशन में सहेजा गया।"

#, python-brace-format
msgid "Warning: Configured model '{0}' is not available in the API. Defaulting to '{1}'."
msgstr "चेतावनी: कॉन्फ़िगर किया गया मॉडल '{0}' API में उपलब्ध नहीं है। डिफ़ॉल्ट रूप से '{1}' का उपयोग किया जा रहा है।"

#, python-brace-format
msgid "File or path not found: {0}"
msgstr "फ़ाइल या पथ नहीं मिला: {0}"

msgid "Processing eml files"
msgstr "eml फ़ाइलें संसाधित की जा रही हैं"

#, python-brace-format
msgid "{0} files were renamed."
msgstr "{0} फ़ाइलों का नाम बदला गया।"

#, python-brace-format
msgid "Process was simulated, files weren't renamed. Use --save to rename {0} files."
msgstr "प्रक्रिया का अनुकरण किया गया, फ़ाइलों का नाम नहीं बदला गया। {0} फ़ाइलों का नाम बदलने के लिए --save का उपयोग करें।"

msgid "It took {}"
msgstr "इसमें {} समय लगा"

msgid "(Without subject)"
msgstr "(बिना विषय के)"

msgid "Error parsing subject"
msgstr "विषय पार्स करने में त्रुटि"

msgid "[Error detected. Won't be renamed]"
msgstr "[त्रुटि का पता चला। नाम नहीं बदला जाएगा]"

msgid "[Error detected. Not Renamed]"
msgstr "[त्रुटि का पता चला। नाम नहीं बदला गया]"

msgid "[Will be renamed]"
msgstr "[नाम बदला जाएगा]"

msgid "[Renamed]"
msgstr "[नाम बदल दिया गया]"

msgid "[Format detected. Won't de renamed]"
msgstr "[प्रारूप का पता चला। नाम नहीं बदला जाएगा]"

msgid "[Format detected. Not renamed]"
msgstr "[प्रारूप का पता चला। नाम नहीं बदला गया]"
